# Copy is created by ./scripts/setup.sh with random values. Never commit .env.
POSTGRES_PASSWORD=
OPENDPO_OWNER_PASSWORD=
OPENDPO_APP_PASSWORD=
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_ADMIN_PASSWORD=
# Password for every fictional demo user (see README)
OPENDPO_DEMO_PASSWORD=
# The drafting agent (optional). Leave the key empty to use the saved fixture draft.
# Create a key at console.anthropic.com and set a monthly spending limit there.
ANTHROPIC_API_KEY=
# anthropic or fixture; empty means anthropic when a key is set, otherwise fixture
OPENDPO_AGENT_PROVIDER=
OPENDPO_AGENT_MODEL=claude-sonnet-5-5
